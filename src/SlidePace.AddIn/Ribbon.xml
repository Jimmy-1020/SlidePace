<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="SlidePaceTab" label="SlidePace 计时">
        <group id="SlidePaceModes" label="计时模式">
          <toggleButton id="ModeCountUp" label="顺计时" getPressed="GetModePressed" onAction="OnModeChanged" screentip="顺计时" supertip="进入放映自动开始；再次点击取消选择。" />
          <toggleButton id="ModeCountDown" label="倒计时" getPressed="GetModePressed" onAction="OnModeChanged" screentip="倒计时" supertip="归零后继续记录超时，默认变为红色。" />
          <toggleButton id="ModeClock" label="系统时间" getPressed="GetModePressed" onAction="OnModeChanged" />
        </group>
        <group id="SlidePaceDuration" label="倒计时时长">
          <editBox id="CountdownDuration" label="时:分:秒" getText="GetDurationText" onChange="OnDurationChanged" sizeString="00:00:00" maxLength="8" />
          <labelControl id="DurationHint" label="归零后继续计时" />
        </group>
        <group id="SlidePaceDisplay" label="框体设置">
          <button id="OpenSettings" label="字体 · 位置 · 颜色 · 双屏" onAction="OnOpenSettings" />
          <toggleButton id="ShowOverlay" label="显示计时" getPressed="GetShowPressed" onAction="OnShowChanged" />
          <button id="OpenHelp" label="使用说明" onAction="OnHelp" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
